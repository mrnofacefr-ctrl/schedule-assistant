# Required: get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-4-5-20250929)
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: if set, ChromaDB will use OpenAI embeddings instead of the
# built-in offline HashingVectorizer for higher-quality semantic retrieval.
# OPENAI_API_KEY=sk-...
